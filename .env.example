# Copy to backend/.env — never commit the real file.

# --- Part B (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# tried in order when a model is overloaded (503) or out of free-tier quota (429)
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
LLM_MAX_CONCURRENT=2
# local Ollama model, added as the last fallback (no quota, works offline). Empty = off.
# qwen2.5:3b fits a 6 GB GPU fully (~25 s/agent). GEMINI_MODEL=ollama/qwen2.5:3b runs fully local, no key.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434
# requests per minute PER MODEL (free tier allows 5)
LLM_RPM=4
# terminal trace of every Gemini call: on | full | off
AI_TRACE=on

# --- Shared ---
# true = API serves contracts/*.json fixtures instead of the live engine
USE_FIXTURES=true

# --- Part A (engine) ---
SEED=42
SIM_TODAY=2026-10-01
DATA_DIR=../data
