{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "axon-api",
      "runtimeExecutable": "${workspaceFolder}/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--port", "8000", "--app-dir", "backend"],
      "port": 8000
    },
    {
      "name": "axon-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    }
  ]
}
