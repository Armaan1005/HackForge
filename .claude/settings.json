{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(python -m engine.*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr status*)",
      "Bash(npm run *)",
      "PowerShell(pytest *)",
      "PowerShell(python -m pytest *)",
      "PowerShell(python -m engine.*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git branch*)",
      "PowerShell(npm run *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)"
    ]
  },
  "respectGitignore": true
}
